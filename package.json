{
	"name": "fln",
	"version": "2.0.0",
	"description": "A local, explainable context compiler for AI coding agents. Analyze, plan, and emit optimal context — with diagnostics. Retrieval without embeddings, context without a server.",
	"keywords": [
		"cli",
		"codebase",
		"llm",
		"prompt",
		"markdown",
		"json",
		"mcp",
		"ai",
		"agent",
		"context",
		"compiler",
		"rag",
		"codebase-context",
		"model-context-protocol",
		"llm-context"
	],
	"homepage": "https://github.com/nesvet/fln#readme",
	"bugs": {
		"url": "https://github.com/nesvet/fln/issues"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/nesvet/fln.git"
	},
	"funding": {
		"type": "patreon",
		"url": "https://www.patreon.com/nesvet"
	},
	"license": "MIT",
	"author": "Eugene Nesvetaev <dev@nesvet.dev> (https://nesvet.dev/)",
	"sideEffects": false,
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"bin": {
		"fln": "./dist/cli/index.js"
	},
	"files": [
		"dist",
		"completions",
		"schema"
	],
	"scripts": {
		"bench": "bun run scripts/bench.ts",
		"bench:ci": "bun run scripts/bench.ts --ci",
		"prebuild": "bun run generate:version",
		"build": "bun build --compile --minify ./src/cli/index.ts --outfile fln",
		"prebuild:npm": "bun run generate:version && rm -rf dist",
		"build:npm": "tsc -p tsconfig.build.json",
		"check:api-discipline": "bun run scripts/check-api-discipline.ts",
		"check:demo-plan": "bun run generate:demo-plan && git diff --exit-code -- assets/demo-plan.md",
		"check:dist": "bun run scripts/check-dist-sync.ts",
		"check:examples": "bun run generate:examples && git diff --exit-code -- \"examples/*.md\"",
		"clean": "rm -rf fln dist",
		"dev": "bun run src/cli/index.ts",
		"generate:completions": "bun run scripts/generate-completions.ts",
		"generate:examples": "bun run scripts/generate-examples.ts",
		"generate:demo-plan": "bun run scripts/generate-demo-plan.ts",
		"generate:version": "bun run scripts/generate-version.ts",
		"install:system": "bun run build && echo 'Requesting sudo to move binary to /usr/local/bin...' && sudo mv ./fln /usr/local/bin/fln && echo 'Installed successfully. Run \"fln --help\" to test.'",
		"install:user": "bun run build && mkdir -p \"$HOME/.local/bin\" && mv ./fln \"$HOME/.local/bin/fln\" && echo 'Installed successfully. Run \"fln --help\" to test.'",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"prepack": "bun run build:npm && bun run check:dist",
		"pretest": "bun run generate:version",
		"record:demo": "./scripts/record-demo.sh",
		"test": "bun test",
		"typecheck": "tsc --noEmit",
		"verify": "bun run generate:version && bun run check:examples && bun run check:demo-plan && bun run lint && bun run check:api-discipline && bun run typecheck && bun run build:npm && bun run check:dist && bun test && bun run build"
	},
	"dependencies": {
		"@modelcontextprotocol/sdk": "^1.30.0",
		"bytes": "^3.1.2",
		"gpt-tokenizer": "^3.4.0",
		"ignore": "^7.0.5",
		"p-limit": "^7.3.0",
		"picocolors": "^1.1.1",
		"strip-ansi": "^7.2.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.9",
		"@nesvet/biome-config": "^2.0.0",
		"@types/bun": "1.4.0",
		"@types/bytes": "^3.1.5",
		"@types/node": "^24.13.3",
		"ajv": "^8.20.0",
		"fast-check": "^4.8.0",
		"typescript": "7.0.2"
	},
	"packageManager": "bun@1.4.0",
	"engines": {
		"bun": ">=1.4.0",
		"node": ">=22.0.0"
	},
	"overrides": {
		"ajv": "^8.20.0",
		"fast-uri": "^3.1.2"
	}
}
